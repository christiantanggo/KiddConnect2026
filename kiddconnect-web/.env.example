# Override API base (Vercel Production). If unset, next.config uses the Railway default in repo.
# NEXT_PUBLIC_API_URL=https://kiddconnect2026-production.up.railway.app
# NEXT_PUBLIC_API_URL=https://api.lefournier.ca

# Site title + dashboard copy (defaults to Le Fournier in lib/appBrand.js).
# NEXT_PUBLIC_APP_DISPLAY_NAME=Le Fournier
# NEXT_PUBLIC_APP_DESCRIPTION=Le Fournier — family projects and YouTube studio
# NEXT_PUBLIC_SITE_URL=https://www.lefournier.ca
